<style>
/* Background Styling */
html {
    /* background-color: #28b750; */

    background-size: cover; /* Ensure the image covers the full background */
    background-position: center; /* Center the background image */
    background-repeat: no-repeat; /* Prevent background image from repeating */
    font-family: "Menlo", monospace;
    overflow: hidden;
    height: 100%;
    transition: background-image 2s ease-in-out;
}

body {
    margin: 0 auto;
    width: 100%;
    padding: 1rem;
    line-height: 1.5;
}

* {
    box-sizing: border-box;
}

h1 {
    margin: 1rem 0;
    font-size: 2.5rem;
}

ul {
    font-size: small;
}

video#background-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1; /* Ensure the video stays behind all content */
}

#reveal-box {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 20px;
    background-color: white;
    border: 2px solid black;
    cursor: pointer;
    z-index: 2; /* Ensure it's clickable above other content */
}

#content-wrapper {
    margin-top: 2rem;
}
</style>